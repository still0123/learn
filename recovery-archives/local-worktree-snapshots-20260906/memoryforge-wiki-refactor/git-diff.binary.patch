+def question_routes(question: str) -> tuple[str, ...]:
+    """Classify a question before retrieval so callers can route follow-up tools."""
+    lowered = question.lower()
+    return tuple(
+        route
+        for route, markers in _QUESTION_ROUTE_MARKERS.items()
+        if any(marker in lowered for marker in markers)
+    )
 
 
