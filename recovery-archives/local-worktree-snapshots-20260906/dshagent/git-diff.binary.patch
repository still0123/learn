 import { createHash } from 'node:crypto'
 
 export const DEFAULT_TIMEOUT_MS = 120_000
+export const MAX_ERROR_SUMMARY_CHARS = 2_000
 export const MAX_OUTPUT_BYTES = 256 * 1024
 export const MAX_OUTPUT_TAIL_CHARS = 4_000
 
+export function summarizeError(error: unknown, maxChars = MAX_ERROR_SUMMARY_CHARS): string {
+  if (!Number.isInteger(maxChars) || maxChars < 0) {
+    throw new RangeError('maxChars must be a non-negative integer')
+  }
+  const stack = new Set<object>()
+  const safeString = (value: unknown): string => {
+    try {
+      return String(value)
+    } catch {
+      return 'unknown error'
+    }
+  }
+  const format = (value: unknown, budget: number): string => {
+    if (budget <= 0) return ''
+    if (typeof value !== 'object' || value === null) return safeString(value).slice(0, budget)
+    if (stack.has(value)) return '[circular error]'.slice(0, budget)
+    stack.add(value)
+    try {
+      const errorValue = value instanceof Error ? value : undefined
+      let output = (errorValue?.message || errorValue?.name || safeString(value)).slice(0, budget)
+      const append = (prefix: string, nested: unknown): void => {
+        const remaining = budget - output.length - prefix.length
+        if (remaining <= 0) return
+        const detail = format(nested, remaining)
+        if (detail.length > 0) output += prefix + detail
+      }
+      if (value instanceof AggregateError) {
+        try {
+          for (const nested of value.errors) append('; ', nested)
+        } catch {}
+      }
+      if (errorValue && 'cause' in errorValue) {
+        try {
+          if (errorValue.cause !== undefined) append('; caused by: ', errorValue.cause)
+        } catch {}
+      }
+      return output.slice(0, budget)
+    } finally {
+      stack.delete(value)
+    }
+  }
+  return format(error, maxChars)
+}
+
 export interface ExitExpectation {
   exitCodes?: number[]
   outputIncludes?: string[]
