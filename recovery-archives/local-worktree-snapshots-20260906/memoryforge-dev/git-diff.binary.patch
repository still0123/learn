+def test_portal_feishu_import_does_not_reenter_workspace_lock(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    workspace = Workspace.initialize(tmp_path / "workspace").root
+    monkeypatch.setattr(
+        feishu_adapter,
+        "_fetch_document",
+        lambda _reference: {
+            "document_id": "debugdocument",
+            "title": "Debug document",
+            "content": "# Debug document\n\nBody.",
+        },
+    )
+    original_lock = Workspace.exclusive_lock
+    lock_depth = 0
+
+    @contextmanager
+    def reject_reentry(opened: Workspace):
+        nonlocal lock_depth
+        assert lock_depth == 0, "Workspace lock must not be re-entered"
+        with original_lock(opened):
+            lock_depth += 1
+            try:
+                yield
+            finally:
+                lock_depth -= 1
+
+    monkeypatch.setattr(Workspace, "exclusive_lock", reject_reentry)
+
+    result = portal_jobs._execute_import(
+        workspace,
+        {"kind": "feishu", "document": "debugdocument", "public": False},
+        lambda *_args: None,
+    )
+
+    assert result["message"] == "来源处理完成。"
+    assert result["changeset_ids"]
+
+
