+def _run_agent_answer(
+    workspace: Path,
+    text: str,
+    *,
+    provider: OpenAICompatibleProvider,
+    allow_local: bool,
+    repository_id: str | None,
+    session_id: str | None,
+) -> AskPayload:
+    """Answer one Feishu message through the bounded MiniClaude agent loop."""
+    payload = run_agent(
+        workspace,
+        text,
+        provider=provider,
+        allow_local=allow_local,
+        repository_id=repository_id,
+        session_id=session_id,
+    )
+    return _agent_payload_to_ask(payload)
+
+
+def _agent_payload_to_ask(payload: AgentPayload) -> AskPayload:
+    """Map the agent loop result onto the shared AskPayload reply shape."""
+    citations = payload["citations"]
+    first = citations[0] if citations else None
+    status = payload["status"]
+    if status == "max_steps" or status == "provider_error":
+        return {
+            "status": "unknown",
+            "evidence_status": "no_local_evidence",
+            "answer": payload["answer"],
+            "supported_claims": [],
+            "unsupported_aspects": [],
+            "citations": [],
+            "wiki_pages": payload["wiki_pages"],
+            "source_id": None,
+            "source_version": None,
+            "locator": None,
+            "quote": None,
+        }
+    return {
+        "status": status,
+        "evidence_status": "grounded" if citations else "no_local_evidence",
+        "answer": payload["answer"],
+        "supported_claims": [],
+        "unsupported_aspects": [],
+        "citations": citations,
+        "wiki_pages": payload["wiki_pages"],
+        "source_id": first["source_id"] if first else None,
+        "source_version": first["source_version"] if first else None,
+        "locator": first["locator"] if first else None,
+        "quote": first["quote"] if first else None,
+    }
