{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MaterialInventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["materials"],
  "properties": {
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "type", "use_case", "reliability"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "type": {"type": "string"},
          "use_case": {"type": "string"},
          "reliability": {"type": "string", "enum": ["high", "medium", "low"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
