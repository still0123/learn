{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfficeActionIssueMap",
  "type": "object",
  "additionalProperties": false,
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "claims", "references", "examiner_logic", "weakness"],
        "properties": {
          "issue_id": {"type": "string"},
          "claims": {
            "type": "array",
            "items": {"type": "string"}
          },
          "references": {
            "type": "array",
            "items": {"type": "string"}
          },
          "examiner_logic": {"type": "string"},
          "weakness": {"type": "string"},
          "counter_points": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
