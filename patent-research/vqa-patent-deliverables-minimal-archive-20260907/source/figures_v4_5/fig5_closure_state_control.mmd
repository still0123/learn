    D510 -- 冲突 --> S513[513 撤回旧事实]
    S511 --> D514{514 必填事实槽是否可唯一填充？}
    S512 --> D514
    S513 --> D514
    D514 -- 是 --> S515[515 受限重组并输出]
    D514 -- 否 --> S516[516 输出证据不足状态或拒答]
    S508 --> S515

    classDef mono fill:#fff,stroke:#000,color:#000,stroke-width:1.5px;
    class R501,R502,W503,W504,W505,K506,S508,S509,S511,S512,S513,S515,S516 mono;
    linkStyle default stroke:#000,stroke-width:1.2px;
