%% 图1：基于增量视频证据与声明依赖闭包的视频问答答案更新控制方法流程图
flowchart TD
    N101[101：接收视频与问题] --> N102[102：从初始证据集E0生成初始答案A0]
    N102 --> N103[103：将A0拆分为原子声明并计算支持状态]
    N103 --> N104{104：必填语义槽是否存在<br/>无声明或非支持状态？}
    N104 -- 否 --> N115
    N104 -- 是 --> N106[106：从E0未覆盖位置获取增量证据ΔE]
    N106 --> N107[107：冻结E+=E0∪ΔE]
    N107 --> N108[108：仅由问题与E+生成A2<br/>生成请求不含A0文本]
    N108 --> N109[109：同一E+、同一配置核验A0与A2]
    N109 --> N110[110：建立声明迁移记录<br/>事实槽—差异槽—见证ID—目标状态]
    N110 --> N111[111：构建下游写入闭包与上游只读证明上下文]
    N111 --> N112{112：迁移、见证与闭包<br/>一致性条件是否全部满足？}
    N112 -- 是 --> N113[113：原子提交闭包候选目标状态]
    N112 -- 否 --> N114[114：不写入候选状态并执行<br/>E+下安全状态转移]
    N113 --> N115[115：仅由已提交或保留状态重组<br/>并执行无新增声明终检]
    N114 --> N115
    N115 --> N116[116：输出答案、结构化证据不足标识或拒答]

    classDef mono fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px;
    classDef decision fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px;
    class N101,N102,N103,N106,N107,N108,N109,N110,N111,N113,N114,N115,N116 mono;
    class N104,N112 decision;
    linkStyle default stroke:#000000,stroke-width:1.2px;
